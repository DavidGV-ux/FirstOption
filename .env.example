# Órbita Salud — variables de entorno
# Copia este archivo como .env y completa los valores NO sensibles.
#
# REGLA: solo se usan claves PUBLISHABLE (anon) en el cliente.
# Nunca incluyas service_role, secret key ni claves de firma en este
# archivo ni en el repositorio. (Incremento 2: aún sin backend.)

# URL del proyecto Supabase (pública, es parte del endpoint).
EXPO_PUBLIC_SUPABASE_URL=

# Clave anon/publishable de Supabase (protegida por RLS, no es secreta).
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Entorno de datos: "demo" fuerza datos sintéticos con banner visible.
EXPO_PUBLIC_DATA_MODE=demo

# Expo Go no incluye SQLCipher. Si quieres probar en Expo Go, define:
# EXPO_PUBLIC_ALLOW_UNENCRYPTED_DB=1
# (base sin cifrar separada + aviso permanente en la UI).
# Sin ese permiso, la app exige development build cifrado y se bloquea
# con un mensaje explícito en lugar de degradar silenciosamente.
